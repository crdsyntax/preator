{
  "name": "praetor",
  "version": "0.1.1",
  "description": "Praetor: Universal Governed Agent Runtime Framework",
  "type": "module",
  "main": "runtime/index.js",
  "exports": {
    ".": "./runtime/index.js",
    "./core": "./runtime/core/index.js",
    "./providers": "./runtime/providers/index.js",
    "./hosts": "./runtime/hosts/index.js",
    "./evaluation": "./runtime/evaluation/index.js"
  },
  "scripts": {
    "agents:audit": "bun scripts/audit-agent-runtime.js",
    "agents:conformance": "bun evaluations/architectural/conformance.js",
