    "agents:enforce": "bun scripts/verify-host-enforcement.js",
    "test": "bun scripts/audit-agent-runtime.js && bun evaluations/security/hardening.js && bun evaluations/architectural/conformance.js && bun scripts/evaluate-agent-runtime.js",
